{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mnemosyne",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AUTH_MODE": "access",
    "ENVIRONMENT": "production",
    "R2_PREFIX": "shadow",
    "WRITE_ENABLED": "false",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  },
  "r2_buckets": [
    { "binding": "WIKI", "bucket_name": "mnemosyne-wiki", "preview_bucket_name": "mnemosyne-wiki-preview" }
  ],
  "d1_databases": [
    { "binding": "WIKI_INDEX", "database_name": "mnemosyne-index", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" }
}
