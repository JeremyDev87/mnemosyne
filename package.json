{
  "name": "mnemosyne",
  "version": "0.1.0",
  "private": true,
  "main": ".webpack/main",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:canary",
    "test:canary": "python3 -m unittest discover -s scripts -p 'test_dobby_read_only_canary.py'",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "build:trust-helper": "bash scripts/build-trust-helper.sh",
    "build:dobby-runtime": "bash scripts/build-dobby-runtime.sh",
    "verify:local-trust-gate": "bash scripts/verify-local-adhoc-trust-gate.sh",
    "package": "npm run build:trust-helper && npm run build:dobby-runtime && electron-forge package && npm run verify:production-asar",
    "verify:production-asar": "node scripts/verify-production-asar.cjs out/*/*.app/Contents/Resources/app.asar",
    "verify:packaged-local-adhoc": "bash scripts/verify-packaged-local-adhoc.sh",
    "package:e2e": "npm run build:trust-helper && env 'MNEMOSYNE''_E2E_BUILD=1' electron-forge package",
    "make": "npm run package && bash scripts/build-macos-pkg.sh",
    "test:e2e": "npm run package:e2e && playwright test"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.1.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "css-loader": "7.1.2",
    "electron": "43.3.0",
    "eslint": "^9.32.0",
    "globals": "^16.5.0",
    "mini-css-extract-plugin": "^2.10.2",
    "ts-loader": "9.5.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "webpack": "^5.104.1",
    "webpack-cli": "6.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.6"
  }
}
